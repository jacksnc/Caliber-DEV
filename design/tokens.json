{
  "$comment": "Single source of truth for the Helios look. scripts/gen_tokens.py turns this into Packages/HeliosDesign/Sources/HeliosDesign/GeneratedTokens.swift and design/tokens.css; CI fails if either is stale. Colours are #RRGGBB or #RRGGBB@alpha. Every value was checked with the audit in Packages/HeliosDesign (WCAG contrast on the worst-case glass backdrop, colour-blind separation).",
  "version": 1,
  "themes": {
    "dark": {
      "label": "Graphite",
      "canvas": { "top": "#0A0B0E", "bottom": "#15171C" },
      "glows": [
        { "color": "#4F6489", "opacity": 0.20, "x": 0.12, "y": 0.04, "radius": 0.75 },
        { "color": "#3A4256", "opacity": 0.14, "x": 0.95, "y": 0.55, "radius": 0.80 }
      ],
      "glass": { "base": "#FFFFFF@0.05", "raised": "#FFFFFF@0.08", "overlay": "#FFFFFF@0.11" },
      "opaque": { "base": "#212327", "raised": "#282A2E", "overlay": "#2F3135" },
      "border": { "highlight": "#FFFFFF@0.20", "lowlight": "#FFFFFF@0.06", "hairline": "#FFFFFF@0.12", "strong": "#FFFFFF@0.42" },
      "shadow": { "color": "#000000@0.45", "radius": 24, "y": 12 },
      "text": { "primary": "#F5F7FA", "secondary": "#C4CAD4", "tertiary": "#A8B1BE", "onAccent": "#06131F" },
      "accent": { "base": "#8AD0FF", "pressed": "#6FC0F5", "subtle": "#8AD0FF@0.16", "focus": "#BFE4FF", "tint": "#8AD0FF@0.16" },
      "data": {
        "energy": "#3D96F5", "protein": "#31AA9A", "carbs": "#C07E15", "fat": "#927CE9",
        "training": "#82960E", "peptide": "#D66A9E", "weight": "#F5F7FA", "reference": "#939CAA"
      },
      "status": { "success": "#6FD08C", "warning": "#F2C14E", "danger": "#FFA198" }
    },
    "light": {
      "label": "Frost",
      "canvas": { "top": "#F7FAFF", "bottom": "#E3EDFA" },
      "glows": [
        { "color": "#7FB6F5", "opacity": 0.40, "x": 0.90, "y": 0.02, "radius": 0.80 },
        { "color": "#BCD8FB", "opacity": 0.50, "x": 0.05, "y": 0.70, "radius": 0.90 }
      ],
      "glass": { "base": "#FFFFFF@0.62", "raised": "#FFFFFF@0.74", "overlay": "#FFFFFF@0.86" },
      "opaque": { "base": "#F4F8FD", "raised": "#F8FAFE", "overlay": "#FBFCFE" },
      "border": { "highlight": "#FFFFFF@0.95", "lowlight": "#FFFFFF@0.55", "hairline": "#0B1626@0.08", "strong": "#0B1626@0.45" },
      "shadow": { "color": "#1B4F9C@0.14", "radius": 24, "y": 10 },
      "text": { "primary": "#0B1626", "secondary": "#41536B", "tertiary": "#566780", "onAccent": "#FFFFFF" },
      "accent": { "base": "#0868B8", "pressed": "#07589C", "subtle": "#0868B8@0.12", "focus": "#0868B8", "tint": "#DCEBFF" },
      "data": {
        "energy": "#0383DD", "protein": "#03918E", "carbs": "#975110", "fat": "#6E47A4",
        "training": "#738C0A", "peptide": "#8C376B", "weight": "#0B1626", "reference": "#5F7089"
      },
      "status": { "success": "#1E7A3C", "warning": "#8A5A00", "danger": "#B3261E" }
    },
    "dark-hc": {
      "extends": "dark",
      "label": "Graphite (increased contrast)",
      "glass": { "base": "#FFFFFF@0.03", "raised": "#FFFFFF@0.05", "overlay": "#FFFFFF@0.07" },
      "border": { "highlight": "#FFFFFF@0.45", "lowlight": "#FFFFFF@0.25", "hairline": "#FFFFFF@0.35", "strong": "#FFFFFF@0.70" },
      "text": { "secondary": "#D6DBE3", "tertiary": "#BDC4CF" }
    },
    "light-hc": {
      "extends": "light",
      "label": "Frost (increased contrast)",
      "glass": { "base": "#FFFFFF@0.80", "raised": "#FFFFFF@0.88", "overlay": "#FFFFFF@0.94" },
      "border": { "highlight": "#FFFFFF@1.00", "lowlight": "#FFFFFF@0.80", "hairline": "#0B1626@0.30", "strong": "#0B1626@0.70" },
      "text": { "secondary": "#2A3A50", "tertiary": "#3F5069" }
    }
  },
  "chartGroups": {
    "$comment": "Colours that can share one chart (any two may sit side by side, so every pair is checked). Distances are Euclidean OKLab x 100, the metric the dataviz skill's validator uses: normal-vision floor 15, protan/deutan floor 8 (Machado 2009, severity 1.0). Everything is also labelled, never colour alone.",
    "macros": { "members": ["protein", "carbs", "fat"], "minNormal": 15, "minCVD": 8 },
    "lifeline": { "members": ["energy", "training", "peptide"], "minNormal": 15, "minCVD": 8 }
  },
  "glass": { "blur": 24, "saturation": 1.4, "material": "ultraThin" },
  "radius": { "chip": 12, "button": 16, "tile": 20, "card": 24, "sheet": 32 },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40],
  "minTarget": 44,
  "type": {
    "hero":         { "style": "largeTitle", "design": "rounded", "weight": "semibold", "monospacedDigit": true,  "cssSize": 34 },
    "display":      { "style": "title",      "design": "rounded", "weight": "semibold", "monospacedDigit": true,  "cssSize": 28 },
    "title":        { "style": "title2",     "design": "default", "weight": "semibold", "monospacedDigit": false, "cssSize": 22 },
    "metricValue":  { "style": "title3",     "design": "rounded", "weight": "semibold", "monospacedDigit": true,  "cssSize": 20 },
    "section":      { "style": "headline",   "design": "default", "weight": "semibold", "monospacedDigit": false, "cssSize": 17 },
    "body":         { "style": "body",       "design": "default", "weight": "regular",  "monospacedDigit": false, "cssSize": 17 },
    "bodyStrong":   { "style": "body",       "design": "default", "weight": "semibold", "monospacedDigit": false, "cssSize": 17 },
    "callout":      { "style": "callout",    "design": "default", "weight": "regular",  "monospacedDigit": false, "cssSize": 16 },
    "subheadline":  { "style": "subheadline","design": "default", "weight": "regular",  "monospacedDigit": false, "cssSize": 15 },
    "footnote":     { "style": "footnote",   "design": "default", "weight": "regular",  "monospacedDigit": false, "cssSize": 13 },
    "metricLabel":  { "style": "caption",    "design": "default", "weight": "medium",   "monospacedDigit": false, "cssSize": 12 },
    "caption":      { "style": "caption",    "design": "default", "weight": "regular",  "monospacedDigit": false, "cssSize": 12 },
    "tab":          { "style": "caption2",   "design": "default", "weight": "medium",   "monospacedDigit": false, "cssSize": 11 }
  },
  "motion": {
    "fast": 0.15, "base": 0.28, "slow": 0.45,
    "springResponse": 0.4, "springDamping": 0.85,
    "reduceMotion": "crossfade only; no parallax, no looping glows, no scanner line animation"
  }
}
